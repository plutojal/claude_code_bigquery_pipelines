-- REFERENCE COPY — this belongs in the data-monitoring Dataform project,
-- not in this repo.
--
-- Alerts when the pipeline logged an error recently. Because pipeline_errors
-- is an append-only log (never refreshed), the assertion is WINDOWED by time
-- so it self-clears: it fails only while there are ERROR rows in the last
-- LOOKBACK_HOURS, and goes green again once the errors stop.
--
-- Set LOOKBACK_HOURS to match how often this Dataform project runs:
--   * runs daily      -> 24 (catches anything since yesterday)
--   * runs hourly     -> 2  (alerts ~once per occurrence, less noisy)
-- The pipeline functions and the freshness monitor re-log a persistent problem
-- on every run, so a real ongoing failure keeps the window populated until fixed.
--
-- WARNING-severity rows are intentionally excluded — only ERROR fails the run.
-- Wire this project's Slack/notification integration to assertion failures.

config {
  type: "assertion",
}

js {
  const LOOKBACK_HOURS = 24;
}

SELECT
  occurred_at,
  component,
  check_name,
  severity,
  message
FROM ${ref("pipeline_errors")}
WHERE severity = 'ERROR'
  AND occurred_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${LOOKBACK_HOURS} HOUR)
ORDER BY occurred_at DESC
