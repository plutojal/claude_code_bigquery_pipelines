-- REFERENCE COPY — this belongs in the data-monitoring Dataform project,
-- not in this repo. pipeline_errors is created and written by the Cloud
-- Functions in claude_code_bigquery_pipelines (append-only audit log), so
-- Dataform must DECLARE it as an external source rather than build it.

config {
  type: "declaration",
  database: "product-analytics-389809",
  schema: "retail_stores",
  name: "pipeline_errors",
  description: "Append-only pipeline failure log written by the retail-store Cloud Functions (log_error). Read by assert_no_recent_pipeline_errors to alert Slack.",
}
