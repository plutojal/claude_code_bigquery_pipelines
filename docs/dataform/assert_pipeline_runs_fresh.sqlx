-- REFERENCE COPY — belongs in the data-health Dataform project, not this repo.
--
-- Fails if any scheduled component has no successful run, or its last one is
-- older than its threshold. This is an INDEPENDENT freshness backstop: it reads
-- the pipeline_runs heartbeats directly, so it still fires even if
-- fn-pipeline-monitor itself is the thing that stopped running (in which case
-- 'fn-pipeline-monitor' shows up stale here).
--
-- Overlaps intentionally with fn-pipeline-monitor's own check — belt and braces.
-- Thresholds must match create_scheduler.sh.

config {
  type: "assertion",
}

WITH expected AS (
  SELECT 'fn-retail-store-matching' AS component, 26 AS max_age_hours UNION ALL
  SELECT 'fn-store-geocoder',        26 UNION ALL
  SELECT 'fn-pipeline-monitor',      26
),

last_runs AS (
  SELECT component, MAX(finished_at) AS last_success_at
  FROM ${ref("pipeline_runs")}
  WHERE status = 'success'
  GROUP BY component
)

SELECT
  e.component,
  r.last_success_at,
  TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), r.last_success_at, HOUR) AS hours_since_success
FROM expected e
LEFT JOIN last_runs r USING (component)
WHERE r.last_success_at IS NULL
   OR TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), r.last_success_at, HOUR) > e.max_age_hours
