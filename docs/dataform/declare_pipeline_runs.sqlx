-- REFERENCE COPY — belongs in the data-health Dataform project, not this repo.
-- pipeline_runs is written by the retail-store Cloud Functions (log_run), so
-- Dataform DECLAREs it as an external source rather than building it.

config {
  type: "declaration",
  database: "product-analytics-389809",
  schema: "retail_stores",
  name: "pipeline_runs",
  description: "Run heartbeats — one row per successful function run (log_run). Used to detect a scheduler that silently never fired.",
}
